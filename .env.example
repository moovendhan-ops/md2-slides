# Copy to .env.local and fill in. Never commit real values.

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Authorization callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# AI generation. On Cloudflare Workers the `AI` binding in wrangler.jsonc is used (Workers AI,
# no key needed; model from WORKERS_AI_MODEL). Elsewhere (local dev, other hosts), set one
# OpenAI-compatible endpoint (base URL + API key + model).
# Examples:
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1                                   AI_MODEL=gpt-4o-mini
#   Gemini      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai     AI_MODEL=gemini-2.5-flash
#   Cloudflare  AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1  AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1                                AI_MODEL=openai/gpt-4o-mini
# Check it works: open the AI dialog (status line) or GET /api/ai/health
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional display name (defaults to the base URL's host)
AI_PROVIDER_NAME=

# Optional: alerts for AI failures and auth errors
DISCORD_WEBHOOK_URL=

# Public site URL (canonical links and social preview images), e.g. https://md2slides.app
NEXT_PUBLIC_SITE_URL=
