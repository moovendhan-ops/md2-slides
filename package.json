{
  "name": "md2-slides",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipBuild",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:engine": "cargo test --manifest-path crates/slide-engine/Cargo.toml",
    "wasm:build": "./scripts/build-wasm.sh",
    "vscode:build": "node vscode-extension/scripts/build.mjs",
    "vscode:dev-build": "node vscode-extension/scripts/build.mjs --dev",
    "vscode:package": "cd vscode-extension && vsce package --no-dependencies --skip-license",
    "vscode:test": "npm run vscode:build && node vscode-extension/test/run.mjs",
    "postinstall": "node scripts/patch-webllm.mjs",
    "player:build": "node scripts/build-player.mjs",
    "predev": "node scripts/patch-webllm.mjs && node scripts/community.mjs && node scripts/build-player.mjs --dev",
    "prebuild": "node scripts/patch-webllm.mjs && node scripts/community.mjs && node scripts/build-player.mjs",
    "community": "node scripts/community.mjs",
    "mcp:build": "node packages/mcp/build.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/web": "^2.1.2",
    "@tanstack/react-query": "^5.103.3",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "mermaid": "^12.0.0",
    "modern-screenshot": "^4.7.0",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0",
    "zod": "^4.6.5"
  }
}
